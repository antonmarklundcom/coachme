# coachme — runtime configuration.
#
# Copy to .env.local for local work, and set the same values in the Vercel
# project's environment settings for the deployed app. Every value is optional
# at BUILD time (nothing here is read during `next build`) and required at
# runtime; each one's graceful-degradation behaviour is written below, so a
# missing value never crashes the coach, it only makes it quieter.

# Neon Postgres connection string (the pooled one). Also works against a plain
# local postgres:// for development.
#   missing → pages say the state of record is unavailable; scripts refuse.
DATABASE_URL=

# The owner gate: any strong random string. `/login` accepts exactly this value
# and sets a signed cookie; middleware checks the cookie on every other route.
#   missing → nothing to log in against, so the gate stands down and the app is
#             open. Set it before the app is deployed anywhere public.
OWNER_SECRET=

# Gates the cron endpoints (/api/scan, and /api/nudge from phase O2). Vercel
# sends `Authorization: Bearer $CRON_SECRET` automatically once this is set in
# the project env.
#   missing → cron endpoints refuse every request (401). Authentication never
#             degrades gracefully; only data does.
CRON_SECRET=

# Anthropic API key for the scan's classification step, on claude-sonnet-5.
# Never Fable, anywhere in this codebase (plan.md §4.8). The chat panel uses
# Gemini instead (below) — a deliberate cost choice, not a drift from this.
#   missing → the deep scan still reads commits, PRs, the live URL and stack
#             metadata, and records those; it just does not judge pct/blocker.
ANTHROPIC_API_KEY=

# Gemini API key for the chat panel (lib/gemini.ts) — asked far more often than
# the scan classifier runs, on a smaller/cheaper model since each question is a
# grounded single-repo lookup, not a harder judgment call.
#   missing → /api/chat answers 503 with a message naming this variable.
GEMINI_API_KEY=

# Which Gemini model the chat panel calls. Defaults to a `-latest` alias so it
# tracks Google's current flash release; pin an exact version (e.g.
# gemini-3.7-flash) if you want reproducibility over always-current instead.
#   missing → defaults to gemini-flash-latest.
GEMINI_MODEL=

# Read-only GitHub PAT (public repos are enough for the `repo` listing).
#   missing → unauthenticated GitHub API access: still works for public repos,
#             but rate-limited to 60 requests/hour, which is not enough for a
#             full scan.
GITHUB_TOKEN=

# Web Push. Generate the pair ONCE with `npm run vapid`, which prints it and
# writes nothing — paste it into the Vercel project env and your .env.local,
# never into the repo. Regenerating the pair silently invalidates every
# subscription already in `push_subscriptions`, so every device stops receiving
# nudges until it re-subscribes.
#   missing → the nudge is still decided, recorded and shown on the dashboard;
#             it just is not delivered to a phone. The dashboard's notification
#             card says "push is not configured yet" rather than failing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The `mailto:` a push service can use to reach the sender (the VAPID subject).
#   missing → defaults to the owner's address; only worth setting if that changes.
VAPID_SUBJECT=
